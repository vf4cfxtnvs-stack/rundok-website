RewriteEngine On

# www und fremde Hostnamen auf rundok.de umleiten
RewriteCond %{HTTP_HOST} !^rundok\.de$ [NC]
RewriteRule ^ https://rundok.de%{REQUEST_URI} [L,R=301]

# HTTPS erzwingen. Zertifikat am 08.09.2026 geprueft: Sectigo OV, gueltig bis 06.03.2027,
# https://rundok.de/ antwortet mit 200. Ohne diese zwei Zeilen war http:// im Klartext erreichbar.
RewriteCond %{HTTPS} off
RewriteRule ^ https://rundok.de%{REQUEST_URI} [L,R=301]

# Interne Dateien nie ausliefern. Der Repo-Ordner ist zugleich der Upload-Ordner;
# ohne diese Sperre waeren README.md (mit IONOS-Vertragsnummer und SFTP-Zugangsdaten)
# und UEBERGABE-Website.md oeffentlich unter rundok.de/README.md abrufbar.
<FilesMatch "\.(md|patch)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/\.git

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
