RewriteEngine On

# www und fremde Hostnamen auf rundok.de umleiten
RewriteCond %{HTTP_HOST} !^rundok\.de$ [NC]
RewriteRule ^ https://rundok.de%{REQUEST_URI} [L,R=301]

# HTTPS erzwingen: die zwei Zeilen erst einkommentieren, wenn das SSL-Zertifikat
# bei IONOS als "aktiv" angezeigt wird, sonst laufen Besucher in eine Zertifikatswarnung.
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://rundok.de%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
